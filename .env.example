# Copy to .env and fill in. Never commit .env.

# Postgres. Local: docker compose up -d. Production: Neon (UK or EU region).
DATABASE_URL=postgres://figcit:figcit@127.0.0.1:5432/figcit

# At least 32 random characters: openssl rand -hex 32
PAYLOAD_SECRET=

# Public URL of the site, used for canonical links, CORS and CSRF.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Vercel Blob store for media (create the store in the London region).
# Leave empty locally: uploads then go to ./media.
BLOB_READ_WRITE_TOKEN=

# Google Analytics 4 measurement ID (starts with G-). Loads only after consent.
NEXT_PUBLIC_GA_MEASUREMENT_ID=

# Forms. Resend sends a notification for each submission; Turnstile stops bots.
RESEND_API_KEY=
FORMS_NOTIFY_TO=admin@figcit.co.uk
FORMS_FROM=Figcit website <forms@figcit.co.uk>
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Protects the daily /cron/retention job (set the same value in Vercel as CRON_SECRET).
CRON_SECRET=
