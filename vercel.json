{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "nextjs",
  "regions": ["lhr1"],
  "installCommand": "pnpm install --frozen-lockfile",
  "buildCommand": "pnpm payload migrate && pnpm seed:if-empty && pnpm build",
  "crons": [
    {
      "path": "/cron/retention",
      "schedule": "15 3 * * *"
    }
  ],
  "git": {
    "deploymentEnabled": false
  }
}
